[core]
	editor = hx
	pager = delta
	compression = 0
	symlinks = true
[delta]
	features = catppuccin-mocha
	navigate = true
[diff]
	colorMoved = default
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = diff3
[pull]
	rebase = true
[submodule]
	recurse = true
