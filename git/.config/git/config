[core]
	editor = hx
	pager = delta
	compression = 0
	symlinks = true
[branch]
	sort = -committerdate
[delta]
	features = catppuccin-mocha
	hyperlinks = true
	navigate = true
	line-numbers = true
	side-by-side = true
[diff]
	algorithm = histogram
	colorMoved = plain
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[submodule]
	recurse = true
